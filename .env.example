# Copy this file to .env and adjust for your own machine before running
# `docker compose up -d --build`.

# Path to YOUR ssh directory (config, private key, known_hosts) — mounted
# read-only into the container so it can SSH to the cluster as you.
# Windows example: C:/Users/<you>/.ssh
# macOS/Linux example: /home/<you>/.ssh or /Users/<you>/.ssh
SSH_DIR=/path/to/your/.ssh

# Host/alias to SSH into for squeue. Either an alias defined in your own
# ~/.ssh/config (e.g. "disi"), or a full user@host if you don't have one set
# up. The jobs shown are always scoped to whichever account this SSHes in
# as (squeue -u $USER, expanded remotely) — never someone else's.
SLURM_SSH_HOST=disi

# Port exposed on your machine.
HOST_PORT=8091

# How often (seconds) the backend re-polls squeue over SSH.
REFRESH_INTERVAL_SECONDS=20
